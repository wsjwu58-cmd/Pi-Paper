{
	"name": "@vibepaper/pi-agent-service",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsgo -p tsconfig.build.json",
		"start": "node dist/server.js",
		"dev": "tsx src/server.ts",
		"generate:skills": "node scripts/generate-skill-manifest.mjs ../../../skills/skills.md",
		"eval": "tsx evals/run-evals.ts",
		"migrate": "tsx src/migrate.ts",
		"test": "vitest --run"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.84.3",
		"@earendil-works/pi-ai": "^0.84.3",
		"@fastify/multipart": "10.1.1",
		"fastify": "5.12.1",
		"ioredis": "6.0.0",
		"pg": "8.23.0",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"vitest": "4.1.9"
	}
}
